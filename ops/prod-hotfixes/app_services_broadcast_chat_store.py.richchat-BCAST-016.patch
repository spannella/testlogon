+# ─── Phase G / F: Scheduled promotion + view-once consume (BCAST-016) ──────
+
+_SCHED_SWEEP_LOCK = threading.Lock()
+_SCHED_SWEEP_LAST: Dict[str, float] = {}
+_SCHED_SWEEP_MIN_INTERVAL = 3.0
+
+
+def promote_due_scheduled_chats(session_id: str, session_is_live: bool) -> int:
+    """Promote (or drop) scheduled chat messages that are now due.
+
+    Held messages live under a ``SCHED#<send_at>#<msg_id>`` sort key and are
+    excluded from history/stream. When ``send_at <= now`` we re-append them as
+    normal messages (fresh time-ordered sort key) if the session is still live,
+    or drop them if the broadcast has ended. Self-throttled per session.
+    """
+    now_s = time.time()
+    with _SCHED_SWEEP_LOCK:
+        last = _SCHED_SWEEP_LAST.get(session_id, 0.0)
+        if now_s - last < _SCHED_SWEEP_MIN_INTERVAL:
+            return 0
+        _SCHED_SWEEP_LAST[session_id] = now_s
+
+    ts = now_ts()
+    try:
+        resp = T.broadcast_chat_messages.query(
+            KeyConditionExpression=Key("session_id").eq(session_id)
+            & Key("sort_key").begins_with("SCHED#"),
+            Limit=50,
+        )
+    except Exception:
+        return 0
+    promoted = 0
+    for it in resp.get("Items", []):
+        send_at = int(it.get("send_at", 0) or 0)
+        if send_at > ts:
+            continue
+        old_sk = it.get("sort_key")
+        if not session_is_live:
+            try:
+                T.broadcast_chat_messages.delete_item(
+                    Key={"session_id": session_id, "sort_key": old_sk}
+                )
+            except Exception:
+                pass
+            continue
+        ts_ms = int(time.time() * 1000)
+        new_sk = f"{ts_ms:016d}#{it['message_id']}"
+        new_item = {k: v for k, v in it.items() if k not in ("sort_key", "scheduled", "send_at")}
+        new_item["sort_key"] = new_sk
+        new_item["created_at"] = ts
+        try:
+            T.broadcast_chat_messages.put_item(Item=new_item)
+            T.broadcast_chat_messages.delete_item(
+                Key={"session_id": session_id, "sort_key": old_sk}
+            )
+        except Exception:
+            continue
+        out = _chat_msg_out(new_item)
+        try:
+            broadcast_sse_publish(session_id, {"_type": "chat:message", **out})
+        except Exception:
+            pass
+        promoted += 1
+    return promoted
+
+
+def consume_view_once(session_id: str, message_id: str, viewer_user_id: str) -> Dict[str, Any]:
+    """Consume a view-once chat message for a viewer (one-view server enforcement)."""
+    from fastapi import HTTPException
+
+    sort_key = _find_sort_key(session_id, message_id)
+    if not sort_key:
+        raise HTTPException(status_code=404, detail="Message not found")
+    item = T.broadcast_chat_messages.get_item(
+        Key={"session_id": session_id, "sort_key": sort_key}
+    ).get("Item")
+    if not item or not item.get("view_once"):
+        raise HTTPException(status_code=400, detail="Message is not a view-once message")
+
+    is_sender = item.get("sender_id") == viewer_user_id
+    seen = item.get("view_once_seen") or set()
+    already = (not is_sender) and (viewer_user_id in seen)
+
+    if not is_sender and not already:
+        try:
+            T.broadcast_chat_messages.update_item(
+                Key={"session_id": session_id, "sort_key": sort_key},
+                UpdateExpression="ADD view_once_seen :u",
+                ExpressionAttributeValues={":u": {viewer_user_id}},
+            )
+        except Exception:
+            pass
+
+    reveal = is_sender or not already
+    return {
+        "ok": True,
+        "message_id": message_id,
+        "view_once": True,
+        "view_once_consumed": (not is_sender),
+        "already_consumed": bool(already),
+        "text": item.get("text") if reveal else None,
+        "image_url": item.get("image_url") if reveal else None,
+        "video_url": item.get("video_url") if reveal else None,
+        "thumbnail_url": item.get("thumbnail_url") if reveal else None,
+        "media_kind": item.get("media_kind"),
+    }
