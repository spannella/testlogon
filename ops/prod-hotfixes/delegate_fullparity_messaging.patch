+@router.post(
+    "/delegate/{creator_id}/conversations/{conversation_id}/messages/{message_id}/reactions",
+)
+def delegate_react_to_message(
+    creator_id: str,
+    conversation_id: str,
+    message_id: str,
+    inp: ReactIn,
+    req: Request = None,
+    user_id: str = Depends(get_messaging_user_id),
+):
+    """REACT / UNREACT to any message in the creator's conversation AS the creator."""
+    _delegate_authorize(creator_id, user_id, conversation_id)
+    result = react_to_message(
+        conversation_id=conversation_id, message_id=message_id, inp=inp,
+        req=req, user_id=creator_id,
+    )
+    from app.services.delegates import _write_audit
+    action = "chat_reaction_removed" if inp.action == "remove" else "chat_reaction_added"
+    try:
+        _write_audit(
+            creator_id, user_id, "delegate", action, conversation_id,
+            {"message_id": message_id, "emoji": inp.emoji},
+        )
+    except Exception:
+        logger.warning("delegate: failed to audit reaction on %s", message_id)
+    return result
