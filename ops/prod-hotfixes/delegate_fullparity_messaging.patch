+# ─────────────────────────────────────────────────────────────────────────────
+# DELEGATE FULL-PARITY MESSAGING (DELEGATE-FULLPARITY)
+# A delegate holding chat_respond can send EVERY message kind normal messaging
+# supports, attributed to the CREATOR (sender_id=creator), tagged as via-delegate
+# and audited. These routes REUSE the exact normal send handlers with
+# user_id=creator (no duplicated send/persist logic) + the exact normal input
+# models (so the delegate contract == the normal contract per kind).
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+def _delegate_authorize(creator_id: str, delegate_id: str, conversation_id):
+    """Authorize a delegate to act as the creator + resolve attribution.
+
+    Requires chat_respond (same gate as the text delegate path). When a
+    conversation_id is given, the CREATOR must be an active participant.
+    Returns (delegate_tag, hide_from_recipients, delegate_display_name).
+    """
+    from app.services.delegates import require_delegate_permission, get_creator_settings
+    from app.services.profile import get_profile
+    delegate_item = require_delegate_permission(
+        creator_id=creator_id,
+        delegate_id=delegate_id,
+        required_permission="chat_respond",
+    )
+    if conversation_id is not None:
+        require_participant_active(creator_id, conversation_id)
+    prof = get_profile(delegate_id) or {}
+    dname = prof.get("display_name") or delegate_id
+    tag = None
+    if delegate_item.get("show_delegate_tag"):
+        fmt = delegate_item.get("delegate_tag_format", "[via @{delegate_name}]")
+        tag = fmt.replace("{delegate_name}", dname)
+    hide = bool(get_creator_settings(creator_id).get("hide_delegate_from_recipients"))
+    return tag, hide, dname
+
+
+def _delegate_tag_input(inp, tag, hide) -> None:
+    """Bake the visible '[via @delegate]' tag into a text/caption field.
+
+    Skipped when attribution is hidden or absent, or when the field is None
+    (e.g. a media-only send/edit) so we never fabricate content. Kinds without a
+    text field keep attribution in the structured fields + audit only.
+    """
+    if not tag or hide:
+        return
+    for field in ("text", "caption"):
+        if hasattr(inp, field):
+            cur = getattr(inp, field)
+            if cur is not None:
+                setattr(inp, field, f"{cur} {tag}".strip())
+            return
+
+
+def _delegate_mid(out) -> str:
+    """Extract a message_id from a handler result (model or dict)."""
+    if hasattr(out, "message_id"):
+        return out.message_id
+    if isinstance(out, dict):
+        return out.get("message_id", "")
+    return ""
+
+
+def _delegate_stamp_and_audit(creator_id, delegate_id, conversation_id, message_id,
+                              dname, tag, action, preview="") -> None:
+    """Stamp delegate metadata onto the affected row + write a delegate audit."""
+    from app.services.delegates import _write_audit
+    if message_id:
+        try:
+            expr = "SET sent_by_delegate = :d, delegate_display_name = :n"
+            vals = {":d": delegate_id, ":n": dname}
+            if tag:
+                expr += ", delegate_tag = :t"
+                vals[":t"] = tag
+            tbl_msgs.update_item(
+                Key={"conversation_id": conversation_id, "message_id": message_id},
+                UpdateExpression=expr,
+                ExpressionAttributeValues=vals,
+            )
+        except Exception:
+            logger.warning("delegate: failed to stamp metadata on %s", message_id)
+    try:
+        _write_audit(
+            creator_id, delegate_id, "delegate", action, conversation_id,
+            {"message_id": message_id, "text_preview": (preview or "")[:100]},
+        )
+    except Exception:
+        logger.warning("delegate: failed to write audit for %s", message_id)
+
