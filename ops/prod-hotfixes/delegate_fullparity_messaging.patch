+@router.post(
+    "/delegate/{creator_id}/conversations/{conversation_id}/messages/text",
+    response_model=MessageOut,
+)
+def delegate_send_text_message(
+    creator_id: str,
+    conversation_id: str,
+    inp: SendTextMessageIn,
+    req: Request = None,
+    user_id: str = Depends(get_messaging_user_id),
+):
+    """TEXT (full gating: encryption / scheduled send_at+tz / view_once /
+    locked PPV / countdown-on-message / tip) AS the creator via delegation."""
+    tag, hide, dname = _delegate_authorize(creator_id, user_id, conversation_id)
+    _delegate_tag_input(inp, tag, hide)
+    out = send_text_message(
+        conversation_id=conversation_id, inp=inp, req=req, user_id=creator_id, _kyc=None
+    )
+    _delegate_stamp_and_audit(
+        creator_id, user_id, conversation_id, _delegate_mid(out), dname, tag,
+        "chat_message_sent", inp.text or "",
+    )
+    return out
+
