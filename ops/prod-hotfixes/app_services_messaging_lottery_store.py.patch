+def list_lottery_unlocks(*, message_id: str, table: Any = None) -> list[dict[str, Any]]:
+    """B-LOTSENDER (#15): enumerate EVERY recipient's unlock for one lottery so the
+    sender can see who unlocked it and which outcome they got. Unlocks are keyed
+    (message_id HASH, recipient_id RANGE), so a single Query on message_id returns
+    all of them."""
+    from boto3.dynamodb.conditions import Key as _Key
+    table = table or _unlocks_table()
+    items: list[dict[str, Any]] = []
+    kwargs: dict[str, Any] = {"KeyConditionExpression": _Key("message_id").eq(str(message_id))}
+    while True:
+        resp = table.query(**kwargs)
+        items.extend(resp.get("Items", []) or [])
+        lek = resp.get("LastEvaluatedKey")
+        if not lek:
+            break
+        kwargs["ExclusiveStartKey"] = lek
+    return items
