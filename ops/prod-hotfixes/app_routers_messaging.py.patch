+        set_parts.append("#f = :file")
+        expr_names["#f"] = "file"
+        expr_vals[":file"] = {
+            "path": _fnode.get("path"), "name": _fnode.get("name"), "size": _fnode.get("size"),
+            "content_type": _fnode.get("content_type") or "application/octet-stream",
+            "thumbnail": _fnode.get("thumbnail"),
