+@router.get("/live", response_model=BroadcastSessionListOut)
+def list_live_sessions_route(
+    limit: int = Query(default=50, ge=1, le=200),
+    ctx: dict = Depends(_ctx),
+):
+    """T3 FIX: public live-discovery feed of CURRENTLY-LIVE broadcasts.
+
+    Any authenticated viewer can call this to find sessions that are live right
+    now (across all creators), so a 2nd-user viewer can discover a host's stream
+    and then join + play it back. `GET /broadcast/sessions?status=live` remains
+    operator-scoped (own-sessions for non-operators, SEC GAP-0111); this feed is
+    the intentionally public read-only currently-live list.
+    """
+    _ = ctx
+    result = list_sessions_by_status("live", limit=limit)
+    items = [_to_session_out(s) for s in result["items"]]
+    return BroadcastSessionListOut(items=items, has_more=bool(result.get("cursor")))
+
