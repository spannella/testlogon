+@router.post("/{video_id}/reactions", response_model=VideoReactionOut)
+def add_video_reaction_endpoint(
+    video_id: str,
+    body: VideoReactionIn,
+    user=Depends(require_ui_session),
+):
+    """B-VIDSOCIAL2 (#2): add an emoji reaction to a video (post-level feed parity)."""
+    if not S.video_gallery_enabled:
