+@router.post("/{ticket_id}/close", response_model=TicketEnvelope, responses=_error_responses())
+def close_own_ticket(
+    ticket_id: str,
+    body: TicketCloseReq,
+    request: Request,
+    _ctx: dict[str, str] = Depends(require_ui_session),
+    user: AuthenticatedUser = Depends(get_authenticated_user),
+):
+    """B8 B-SUP2 #15: the ticket OWNER (or an admin) closes/cancels their own
+    ticket. close -> "done"; cancel -> "cancelled". Owner-authorized (unlike the
+    admin-only POST /{ticket_id}/status)."""
+    ticket = _ticket_or_404(ticket_id)
+    if ticket.get("owner_sub") != user.sub and not _is_admin_actor(request, user):
+        _raise(403, "not_ticket_owner", "only the ticket owner or an admin may close this ticket")
+    terminal = "done" if body.action == "close" else "cancelled"
+    try:
+        updated = STORE.owner_close_ticket(ticket_id=ticket["ticket_id"], actor_sub=user.sub, terminal_status=terminal)
+    except TicketStateError as exc:
+        raise HTTPException(status_code=_ticket_state_http_status(exc), detail=_ticket_state_error(exc)) from exc
+    if updated is None:
+        _raise(404, "ticket_not_found", "ticket not found")
+    sync_incident_from_ticket(DynamoPaymentIncidentRepository(), ticket_id=ticket_id, ticket_status=terminal)
+    _emit_ticket_alerts("ticket_status_changed", recipients=[ticket["owner_sub"]], actor_sub=user.sub, request=request, ticket_id=ticket_id, ticket_subject=ticket.get("subject", ""), status=terminal)
+    return _wrap_ticket(updated)
+
+
