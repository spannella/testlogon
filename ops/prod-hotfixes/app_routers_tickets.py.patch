 def _error(code: str, message: str, *, details: dict[str, Any] | None = None) -> dict[str, Any]:
     return {"error": {"code": code, "message": message, "details": details}}
 
 
+def _resolve_ticket_media(media: "list[TicketMediaIn] | None", user_sub: str) -> list[dict[str, Any]]:
+    """B10 B-HELPMEDIA: normalize the inbound media list into plain dicts stored
+    on the ticket message. A file_ref (file-manager VFS path) is resolved to its
+    node metadata so clients can render/download it without a second round-trip.
+    Best-effort: an unresolvable file_ref is dropped rather than failing the
+    whole ticket create/reply."""
+    if not media:
+        return []
+    out: list[dict[str, Any]] = []
+    for m in media:
+        item: dict[str, Any] = {"kind": m.kind}
+        if m.kind == "file_ref":
+            if not m.path:
+                continue
+            try:
+                from app.services.filemanager import get_node, norm_path
+                _p = norm_path(m.path, is_folder=False)
+                node = get_node(user_sub, _p)
+                if (node or {}).get("type") != "file":
+                    continue
+                item.update({
+                    "path": node.get("path"),
+                    "name": node.get("name"),
+                    "content_type": node.get("content_type") or "application/octet-stream",
+                    "size_bytes": int(node["size"]) if node.get("size") is not None else None,
+                })
+                if node.get("thumbnail"):
+                    item["thumbnail"] = node.get("thumbnail")
+            except Exception:
+                continue
+        else:
+            if not m.url:
+                continue
+            item["url"] = m.url
+            if m.name: item["name"] = m.name
+            if m.content_type: item["content_type"] = m.content_type
+            if m.size_bytes is not None: item["size_bytes"] = m.size_bytes
+            if m.width is not None: item["width"] = m.width
+            if m.height is not None: item["height"] = m.height
+        out.append({k: v for k, v in item.items() if v is not None})
+    return out
+
+
