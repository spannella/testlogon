+def _resolve_caller_name(user_id: str) -> str:
+    """T2 FIX: best-effort human caller name (display_name -> users table -> email -> sub)."""
+    try:
+        ident = get_profile_identity(user_id) or {}
+        name = (ident.get("display_name") or "").strip()
+        if name:
+            return name
+        row = tbl_users.get_item(Key={"user_id": user_id}).get("Item") or {}
+        name = (row.get("display_name") or "").strip()
+        if name:
+            return name
+        email = (ident.get("email") or row.get("email") or "").strip()
+        if email:
+            return email.split("@")[0]
+    except Exception:
+        pass
+    return user_id.split("@")[0] if "@" in user_id else user_id
+
