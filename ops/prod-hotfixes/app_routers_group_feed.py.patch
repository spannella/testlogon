+# ── Group post comments (B9 B-GRPFULL #11) ────────────────────────────────────
+
+@router.post("/ui/groups/{group_id}/posts/{post_id}/comments", status_code=201)
+def add_group_post_comment(
+    group_id: str,
+    post_id: str,
+    body: CreateGroupCommentIn,
+    session=Depends(require_ui_session),
+):
+    _require_feed_enabled()
+    from app.services.group_feed import add_group_comment
+    try:
+        return add_group_comment(
+            group_id=group_id,
+            post_id=post_id,
+            user_id=session["user_sub"],
+            text=body.text,
+            image_url=body.image_url,
+            parent_comment_id=body.parent_comment_id,
+        )
+    except PermissionError as e:
+        raise HTTPException(403, str(e))
+    except ValueError as e:
+        msg = str(e)
+        if "dissolved" in msg:
+            raise HTTPException(410, msg)
+        if "must include" in msg:
+            raise HTTPException(422, msg)
+        raise HTTPException(404, msg)
+
+
+@router.get("/ui/groups/{group_id}/posts/{post_id}/comments")
+def list_group_post_comments(
+    group_id: str,
+    post_id: str,
+    cursor: str | None = Query(default=None),
+    limit: int = Query(default=20, ge=1, le=100),
+    session=Depends(require_ui_session),
+):
+    _require_feed_enabled()
+    from app.services.group_feed import list_group_comments
+    try:
+        return list_group_comments(
+            group_id=group_id,
+            post_id=post_id,
+            viewer_id=session["user_sub"],
+            cursor=cursor,
+            limit=limit,
+        )
+    except ValueError as e:
+        raise HTTPException(404, str(e))
+
+
+@router.delete("/ui/groups/{group_id}/posts/{post_id}/comments/{comment_id}")
+def delete_group_post_comment(
+    group_id: str,
+    post_id: str,
+    comment_id: str,
+    session=Depends(require_ui_session),
+):
+    _require_feed_enabled()
+    from app.services.group_feed import delete_group_comment
+    try:
+        return delete_group_comment(
+            group_id=group_id,
+            post_id=post_id,
+            comment_id=comment_id,
+            user_id=session["user_sub"],
+        )
+    except PermissionError as e:
+        raise HTTPException(403, str(e))
+    except ValueError as e:
+        raise HTTPException(404, str(e))
