+def _b9_unique_upload_path(owner: str, path: str) -> str:
+    """B-DUPFILE #30: sending the SAME filename twice in one conversation must
+    succeed. The messaging file pipeline uploads to a VFS path
+    /messages/<conversation_id>/<filename>; a second identical filename would
+    collide and require_not_exists() would 409. Instead, derive a unique sibling
+    path by inserting ' (1)', ' (2)', ... before the extension until the path is
+    free. Returns the original path when it is already free."""
+    p = norm_path(path, is_folder=False)
+    tbl = _table()
+    if "Item" not in tbl.get_item(Key=node_key(owner, p), ConsistentRead=True):
+        return p
+    parent, name = split_parent_name(p)
+    if "." in name and not name.startswith("."):
+        stem, ext = name.rsplit(".", 1)
+        ext = "." + ext
+    else:
+        stem, ext = name, ""
+    parent_prefix = "" if parent in ("/", "") else parent.rstrip("/")
+    for n in range(1, 1000):
+        cand_name = f"{stem} ({n}){ext}"
+        cand = norm_path(f"{parent_prefix}/{cand_name}", is_folder=False)
+        if "Item" not in tbl.get_item(Key=node_key(owner, cand), ConsistentRead=True):
+            return cand
+    raise HTTPException(409, "too many duplicate filenames")
