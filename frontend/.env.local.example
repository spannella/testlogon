# Frontend environment variables for local dev
# This file is auto-updated by scripts/local-cognito-init.py on dev-stack startup.
# Copy to frontend/.env.local if it doesn't exist, then run: scripts/dev.sh start

# Feature flags
VITE_MESSAGING_ENCRYPTED_MESSAGES_ENABLED=true
VITE_NEWSFEED_MARKDOWN_ENABLED=true
VITE_NEWSFEED_RICHTEXT_ENABLED=true

# Internal Dev Log UI (dev-only)
VITE_ENABLE_DEVTOOLS_LOG_UI=true

# Cognito — auto-populated by local-cognito-init.py on dev-stack startup.
# Leave empty here; the startup script fills them in.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_ISSUER_URL=
VITE_COGNITO_JWKS_URL=

# API base URL — leave unset for local dev so all API calls route through the
# Vite proxy (/ui, /v1, etc. → localhost:8000). Setting it to an absolute URL
# breaks cookie-scoping for SSE and session auth.
# VITE_API_BASE_URL=
