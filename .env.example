# =============================================================================
# ENVIRONMENT CONFIGURATION — copy to .env and fill in values
# =============================================================================
# Most settings have safe defaults for local development (DEV_MODE=1).
# Only the "REQUIRED FOR LOCAL DEV" items need values to boot the app.
# Everything else is optional and enables specific features.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. CORE / DEV MODE (required for local dev)
# ---------------------------------------------------------------------------
DEV_MODE=1                         # 1 = skip Cognito JWT, accept Bearer <user_id>
AWS_REGION=us-east-1               # AWS region for all SDK calls
UI_ACCESS_TOKEN_SECRET=change-me-to-a-random-secret   # HS256 key for access tokens
WS_TOKEN_SECRET=change-me-ws-secret                   # HMAC key for WebSocket tokens

# ---------------------------------------------------------------------------
# 2. AWS CREDENTIALS (required — even for local DynamoDB)
# ---------------------------------------------------------------------------
# Option A: real AWS credentials (for real DynamoDB, S3, KMS, SES)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Option B: local DynamoDB (see DEPLOYMENT.md for setup)
# AWS_ACCESS_KEY_ID=fakeMyKeyId
# AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey
# AWS_ENDPOINT_URL=http://localhost:8001     # only needed for DynamoDB Local

# ---------------------------------------------------------------------------
# 3. AWS COGNITO (optional — skipped when DEV_MODE=1)
# ---------------------------------------------------------------------------
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_REGION=us-east-1
# COGNITO_EXPECTED_TOKEN_USE=access
# COGNITO_JWKS_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# 4. DYNAMODB TABLE NAMES (all have defaults — override only if needed)
# ---------------------------------------------------------------------------
# DDB_SESSIONS_TABLE=sessions
# DDB_TOTP_TABLE=totp_devices
# DDB_SMS_TABLE=sms_devices
# DDB_RECOVERY_TABLE=recovery_codes
# DDB_EMAIL_TABLE=email_devices
# API_KEYS_TABLE_NAME=api_keys
# ALERTS_TABLE_NAME=alerts
# ALERT_PREFS_TABLE_NAME=alert_prefs
# PUSH_DEVICES_TABLE_NAME=push_devices
# PROFILE_TABLE_NAME=profiles
# ADDRESSES_TABLE_NAME=addresses
# CALENDAR_TABLE_NAME=calendar
# PURCHASE_TRANSACTIONS_TABLE_NAME=purchase_transactions
# PURCHASE_EVENTS_TABLE_NAME=purchase_transaction_events
# SHOPPING_CART_TABLE_NAME=shopping_cart
# CATALOG_TABLE_NAME=shopping_catalog
# SUBSCRIPTIONS_TABLE_NAME=subscriptions
# BILLING_TABLE_NAME=billing
# ACCOUNT_STATE_TABLE_NAME=account_state
# FILEMGR_TABLE=file_manager

# ---------------------------------------------------------------------------
# 5. AWS KMS (optional — needed for TOTP secret encryption)
# ---------------------------------------------------------------------------
# KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# API_KEY_PEPPER=random-pepper-string

# ---------------------------------------------------------------------------
# 6. AWS SES (optional — needed for email alerts & MFA codes)
# ---------------------------------------------------------------------------
# SES_FROM_EMAIL=noreply@yourdomain.com
# ALERTS_FROM_EMAIL=alerts@yourdomain.com

# ---------------------------------------------------------------------------
# 7. AWS S3 (optional — needed for file manager & chat images)
# ---------------------------------------------------------------------------
# FILEMGR_BUCKET=my-app-files
# S3_BUCKET_IMAGES=my-chat-images
# FILEMGR_MEDIA_PREVIEWS_V1=false
# FILEMGR_VIDEO_HOVER_CLIP_ENABLED=true
# FILEMGR_AUDIO_WAVEFORM_ENABLED=true
# FILEMGR_VIDEO_PREVIEW_MAX_MB=200
# FILEMGR_VIDEO_PREVIEW_MAX_DURATION_SECONDS=600
# FILEMGR_VIDEO_PREVIEW_CLIP_SECONDS=6
# FILEMGR_VIDEO_PREVIEW_TARGET_HEIGHT=360
# FILEMGR_AUDIO_WAVEFORM_MAX_MB=100
# FILEMGR_PREVIEW_JOB_TIMEOUT_SECONDS=120
# FILEMGR_PREVIEW_WORKER_CONCURRENCY=4
# FILEMGR_PREVIEW_JOB_MAX_ATTEMPTS=3
# FILEMGR_MEDIA_PREVIEW_CDN_BASE_URL=
# FILEMGR_MEDIA_PREVIEW_URL_TTL_SECONDS=900
# FILEMGR_MEDIA_PREVIEW_PRIVATE=true

# ---------------------------------------------------------------------------
# 8. STRIPE (optional — payment processing)
# ---------------------------------------------------------------------------
# Get keys from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=<your-stripe-secret-key>
# STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
# STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>
# STRIPE_DEFAULT_CURRENCY=usd
# STRIPE_SUCCESS_URL=http://localhost:3000/billing?success=1
# STRIPE_CANCEL_URL=http://localhost:3000/billing?cancel=1

# ---------------------------------------------------------------------------
# 9. PAYPAL (optional — alternative payment processing)
# ---------------------------------------------------------------------------
# Get keys from: https://developer.paypal.com/dashboard/applications/sandbox
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PLAN_MAP={"monthly":"P-XXXXX","yearly":"P-YYYYY"}

# ---------------------------------------------------------------------------
# 10. CCBILL (optional — alternative payment processing)
# ---------------------------------------------------------------------------
# CCBILL_FRONTEND_CLIENT_ID=
# CCBILL_FRONTEND_CLIENT_SECRET=
# CCBILL_BACKEND_CLIENT_ID=
# CCBILL_BACKEND_CLIENT_SECRET=
# CCBILL_CLIENT_ACCNUM=0
# CCBILL_CLIENT_SUBACC=0
# CCBILL_WEBHOOK_VERIFY_MODE=ip+sig    # ip+sig (strict), sig_only, local
# CCBILL_WEBHOOK_SIGNATURE_SECRET=
# CCBILL_WEBHOOK_IP_ENFORCE=false
# CCBILL_MOCK_ENABLED=0              # set to 1 for local mock provider endpoints
# CCBILL_BASE_URL=http://localhost:8000/mock/ccbill


# UPS_BASE_URL=https://wwwcie.ups.com/api
# UPS_AUTH_URL=https://wwwcie.ups.com/security/v1/oauth/token
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
# UPS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 11. TWILIO (optional — SMS MFA)
# ---------------------------------------------------------------------------
# Get keys from: https://console.twilio.com
# TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
# TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
# TWILIO_VERIFY_SERVICE_SID=<your-twilio-verify-service-sid>

# ---------------------------------------------------------------------------
# 12. FIREBASE CLOUD MESSAGING (optional — push notifications)
# ---------------------------------------------------------------------------
# Get from: Firebase Console > Project Settings > Service Accounts > Generate Key
# PUSH_ENABLED=0
# FCM_ENABLED=0
# FCM_PROJECT_ID=my-firebase-project
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@my-firebase-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# 13. HAVE I BEEN PWNED (optional — password breach checking)
# ---------------------------------------------------------------------------
# Get key from: https://haveibeenpwned.com/API/Key
# HIBP_ENABLED=0
# HIBP_API_KEY=

# ---------------------------------------------------------------------------
# 14. WEBAUTHN / FIDO2 (optional — passkey authentication)
# ---------------------------------------------------------------------------
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=YourApp
# WEBAUTHN_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# 15. OPENSEARCH (optional — message search)
# ---------------------------------------------------------------------------
# OPENSEARCH_ENDPOINT=https://search-my-domain.us-east-1.es.amazonaws.com
# OPENSEARCH_INDEX=messages
# OPENSEARCH_REGION=us-east-1

# ---------------------------------------------------------------------------
# 16. MESSAGING TABLES (all have defaults)
# ---------------------------------------------------------------------------
# DDB_CONVERSATIONS=Conversations
# DDB_PARTICIPANTS=Participants
# DDB_MESSAGES=Messages
# DDB_USER_EVENTS=UserEvents
# DDB_USERS=Users
# DDB_USER_SEARCH=UserSearch
# DDB_MESSAGE_SEARCH=MessageSearch
# DDB_PRESENCE=UserPresence
# DDB_TYPING=Typing
# DDB_MESSAGE_EDITS=MessageEdits
# DDB_MESSAGE_VIEWS=MessageViews
# DDB_MESSAGE_RECEIPTS=MessageReceipts
# DDB_MESSAGE_CONSUMPTION=MessageConsumption

# ---------------------------------------------------------------------------
# 17. ALERT CHANNELS (all disabled by default)
# ---------------------------------------------------------------------------
# ALERTS_ENABLED=1
# ALERTS_EMAIL_ENABLED=0
# ALERTS_SMS_ENABLED=0
# ALERTS_WEBHOOK_ENABLED=0
# ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERTS_WEBHOOK_SECRET=
# ALERTS_PUSH_MAX_PER_WINDOW=20
# ALERTS_PUSH_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# 18. SESSION & COOKIE TUNING (safe defaults for local dev)
# ---------------------------------------------------------------------------
# UI_SESSION_TTL_SECONDS=2592000
# UI_INACTIVITY_SECONDS=900
# UI_COOKIE_SECURE=0              # Set to 1 in production (HTTPS)
# UI_COOKIE_SAMESITE=lax
# PUBLIC_BASE_URL=http://localhost:8000


# ---------------------------------------------------------------------------
# 18b. API USAGE METERING POLICY (AMB-002 defaults)
# ---------------------------------------------------------------------------
# API_USAGE_BILLABLE_STATUS_CLASSES=2xx
# API_USAGE_QUOTA_STATUS_CLASSES=2xx,4xx,5xx
# API_USAGE_RATE_LIMIT_BILLABLE=false
# API_USAGE_RATE_LIMIT_COUNTS_TOWARD_QUOTA=true
# API_USAGE_AUTH_FAILED_BILLABLE=false
# API_USAGE_AUTH_FAILED_COUNTS_TOWARD_QUOTA=true
# API_USAGE_DEFAULT_PRICING_CATALOG_VERSION=v1
# API_USAGE_PRICING_MISSING_ROUTE_BEHAVIOR=default_route   # default_route|zero_price|error
# API_USAGE_PRICING_CATALOG={"versions":[{"pricing_catalog_version":"v1","effective_at":"2026-01-01T00:00:00Z","routes":{},"default_route":{"price_per_call_micros":0}}]}
# API_USAGE_TABLE_NAME=file_manager
# API_USAGE_EVENT_RETENTION_DAYS=365
# API_USAGE_ACCOUNT_RPS_LIMIT=0
# API_USAGE_ACCOUNT_RPM_LIMIT=0
# API_USAGE_ACCOUNT_DAILY_CALLS_LIMIT=0
# API_USAGE_ACCOUNT_MONTHLY_CALLS_LIMIT=0
# API_USAGE_ACCOUNT_MONTHLY_SPEND_MICROS_LIMIT=0

# ---------------------------------------------------------------------------
# 19. BACKGROUND JOBS (all disabled by default)
# ---------------------------------------------------------------------------
# BILLING_RECONCILE_ENABLED=false
# BILLING_DUNNING_ENABLED=false
# FILEMGR_PURGE_ENABLED=false

# Messaging encrypted messages rollout flags
MESSAGING_ENCRYPTED_MESSAGES_ENABLED=false
MESSAGING_ENCRYPTED_MESSAGES_KILL_SWITCH=false

# Messaging gallery rollout flags
MESSAGING_GALLERY_ENABLED=true
MESSAGING_GALLERY_KILL_SWITCH=false

# Messaging gallery phase-2 materialized index
MESSAGING_GALLERY_INDEX_ENABLED=false
DDB_MESSAGE_GALLERY_INDEX=
