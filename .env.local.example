AWS_REGION=us-east-1
DEV_MODE=1

# Fake credentials for moto / LocalStack (any non-empty value works)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB Local
DDB_ENDPOINT_URL=http://localhost:8001

# DynamoDB table names (must match local-ddb-init.py defaults)
DDB_SESSIONS_TABLE=sessions
DDB_TOTP_TABLE=totp_devices
DDB_SMS_TABLE=sms_devices
DDB_RECOVERY_TABLE=recovery_codes
DDB_EMAIL_TABLE=email_devices
# Messaging Users table: use a distinct name to avoid a DynamoDB Local SQLite
# case-collision with the auth `users` table (DynamoDB Local treats table names
# case-insensitively in its SQLite backend, so "Users" and "users" clash).
DDB_USERS=ddb_users
# File-manager DDB table (must match the name local-ddb-init.py creates)
FILEMGR_TABLE=file_manager

# LocalStack (Cognito + KMS only — S3 is mocked in-process via moto)
AWS_ENDPOINT_URL=http://localhost:4566
# S3 is handled by moto in-process (DEV_MODE=1); no S3_ENDPOINT_URL needed.
S3_ENDPOINT_URL=
S3_USE_PATH_STYLE=0
COGNITO_ENDPOINT_URL=http://localhost:4566

# Mock KMS (scripts/mock_kms_server.py — started by local-stack-up.sh)
KMS_ENDPOINT_URL=http://localhost:7999
# KMS_KEY_ID is populated automatically by local-kms-init.py on each dev-stack startup.
KMS_KEY_ID=

# Buckets
UPLOAD_BUCKET=local-uploads
S3_BUCKET_IMAGES=local-chat-images
FILEMGR_BUCKET=local-filemgr

# Cognito (auto-populated by local-cognito-init.py on first dev-stack startup)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_ISSUER_URL=
COGNITO_JWKS_URL=

# Stripe mock (stripe-mock server on port 12111)
STRIPE_SECRET_KEY=sk_test_local
STRIPE_PUBLISHABLE_KEY=pk_test_local
STRIPE_WEBHOOK_SECRET=whsec_local
STRIPE_API_BASE=http://localhost:12111

# CCBill local webhook verification
CCBILL_WEBHOOK_VERIFY_MODE=local
CCBILL_WEBHOOK_SIGNATURE_SECRET=local-ccbill-webhook-secret

# CCBill local mock provider
CCBILL_MOCK_ENABLED=1
CCBILL_BASE_URL=http://localhost:8000/mock/ccbill
CCBILL_FRONTEND_CLIENT_ID=local_frontend
CCBILL_FRONTEND_CLIENT_SECRET=local_frontend_secret
CCBILL_BACKEND_CLIENT_ID=local_backend
CCBILL_BACKEND_CLIENT_SECRET=local_backend_secret

# PayPal local mock provider
PAYPAL_MOCK_ENABLED=1
PAYPAL_BASE_URL=http://localhost:8000/mock/paypal
PAYPAL_CLIENT_ID=local_paypal_client
PAYPAL_CLIENT_SECRET=local_paypal_secret
PAYPAL_WEBHOOK_ID=local_paypal_webhook_id
PAYPAL_PLAN_MAP=monthly:MOCK-PLAN-MONTHLY

# UPS local mock provider
UPS_BASE_URL=http://localhost:8000/mock/ups
UPS_AUTH_URL=http://localhost:8000/mock/ups/oauth/token
UPS_CLIENT_ID=local_ups_client
UPS_CLIENT_SECRET=local_ups_secret
UPS_WEBHOOK_SECRET=local-ups-webhook-secret

# Session access token — auto-generated by scripts/setup_ubuntu.sh on first run
# (generate manually: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
UI_ACCESS_TOKEN_SECRET=

# API key pepper — auto-generated by scripts/setup_ubuntu.sh on first run
# (generate manually: python3 -c "import secrets; print(secrets.token_hex(32))")
API_KEY_PEPPER=

# Root user configuration for local dev/testing
ROOT_USER_SUB=root.admin@testdev.local
ROOT_LOGIN_LOCAL_ONLY=true
# Filemgr admin users (comma-separated user_subs)
FILEMGR_ADMIN_USERS=root.admin@testdev.local

# Relaxed rate limits for local dev/testing
LOGIN_ATTEMPT_MAX_PER_WINDOW=200
LOGIN_ATTEMPT_WINDOW_SECONDS=60

# Helpdesk group membership for E2E testing
HELPDESK_GROUP_MEMBERS_JSON='{"e2e-helpdesk":["e2e_alice@test.local"]}'
# Wider online window for reliable E2E testing (default: 30s)
ONLINE_WINDOW_SEC=300

# Local SES / Twilio dev mocks
# In DEV_MODE=1, emails and SMS codes are written to these log files instead of
# being delivered. Open them to retrieve codes during local development.
SES_FROM_EMAIL=dev-no-reply@example.com
DEV_EMAIL_LOG=.logs/dev/emails.log
DEV_SMS_LOG=.logs/dev/sms.log

# Internal Dev Log UI discovery paths
DEVTOOLS_EMAIL_LOG_PATH=.logs/dev/emails.log
DEVTOOLS_SMS_LOG_PATH=.logs/dev/sms.log
DEVTOOLS_BILLING_STRIPE_LOG_PATH=.local/logs/stripe-mock.log
DEVTOOLS_BILLING_BACKEND_LOG_PATH=.logs/dev/backend.log

# Feature flags (all enabled for local dev)
MESSAGING_ENCRYPTED_MESSAGES_ENABLED=true
MESSAGING_ENCRYPTED_MESSAGES_KILL_SWITCH=false
MESSAGING_GALLERY_ENABLED=true
MESSAGING_GALLERY_KILL_SWITCH=false
MESSAGING_GALLERY_INDEX_ENABLED=false
NEWSFEED_MARKDOWN_ENABLED=true
NEWSFEED_RICHTEXT_ENABLED=true

# Signature PDF feature
SIGNATURE_PDF_ENABLED=true

# FIN-001: Invoice / Receipt PDF
INVOICES_ENABLED=true

# FIN-004: Consumer Tax Documents (annual creator earnings / 1099-style summaries)
TAX_DOCUMENTS_ENABLED=true
# Minimum yearly credited earnings (cents) required to issue a tax document (0 = no minimum).
TAX_DOCUMENTS_MIN_EARNINGS_CENTS=0

# FINRA / compliance features
MESSAGING_REPORTING_ENABLED=true
MESSAGING_COMPLIANCE_ARCHIVE_ENABLED=true
MESSAGING_COMPLIANCE_EXPORT_ENABLED=true
MESSAGING_COMPLIANCE_LEGAL_HOLD_ENABLED=true
MESSAGING_SUPERVISORY_FEED_ENABLED=true

# Google Calendar integration rollout flags
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_WRITEBACK_ENABLED=false
GOOGLE_CALENDAR_TOKENS_KMS_KEY_ID=
GOOGLE_CALENDAR_SYNC_ROLLOUT_MODE=all
GOOGLE_CALENDAR_SYNC_ROLLOUT_COHORT_USER_SUBS=
GOOGLE_CALENDAR_SYNC_ROLLOUT_PERCENT=100
VITE_GOOGLE_CALENDAR_SYNC_ENABLED=false
VITE_GOOGLE_CALENDAR_WRITEBACK_ENABLED=false
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_OAUTH_AUTH_BASE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_CALENDAR_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_CALENDAR_CONNECTION_DEFAULT_ID=google-primary
GOOGLE_CALENDAR_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_CALENDAR_OAUTH_REQUIRE_REFRESH_TOKEN=true
GOOGLE_CALENDAR_API_BASE_URL=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_API_TIMEOUT_SECONDS=20
GOOGLE_CALENDAR_API_RETRY_AFTER_MAX_SECONDS=60
GOOGLE_CALENDAR_OUTBOUND_RETRY_MAX_ATTEMPTS=5
GOOGLE_CALENDAR_OUTBOUND_RETRY_BASE_SECONDS=5
GOOGLE_CALENDAR_OUTBOUND_RETRY_MAX_SECONDS=300
GOOGLE_CALENDAR_OUTBOUND_RETRY_JITTER_RATIO=0.2
GOOGLE_CALENDAR_FULL_IMPORT_PAST_DAYS=365
GOOGLE_CALENDAR_FULL_IMPORT_FUTURE_DAYS=365
GOOGLE_CALENDAR_EVENT_TOMBSTONE_RETENTION_DAYS=90

# File manager media preview rollout flags
FILEMGR_MEDIA_PREVIEWS_V1=false
FILEMGR_VIDEO_HOVER_CLIP_ENABLED=true
FILEMGR_AUDIO_WAVEFORM_ENABLED=true
FILEMGR_VIDEO_PREVIEW_MAX_MB=200
FILEMGR_VIDEO_PREVIEW_MAX_DURATION_SECONDS=600
FILEMGR_VIDEO_PREVIEW_CLIP_SECONDS=6
FILEMGR_VIDEO_PREVIEW_TARGET_HEIGHT=360
FILEMGR_AUDIO_WAVEFORM_MAX_MB=100
FILEMGR_PREVIEW_JOB_TIMEOUT_SECONDS=120
FILEMGR_PREVIEW_WORKER_CONCURRENCY=4
FILEMGR_PREVIEW_JOB_MAX_ATTEMPTS=3
FILEMGR_MEDIA_PREVIEW_CDN_BASE_URL=
FILEMGR_MEDIA_PREVIEW_URL_TTL_SECONDS=900
FILEMGR_MEDIA_PREVIEW_PRIVATE=true

# KYC tiered verification levels (KYC-009)
KYC_TIER_GATING_ENABLED=true

# KYC identity document verification (KYC-002)
KYC_DOCUMENTS_VERIFICATION_ENABLED=true
# When false (default) a deterministic mock OCR provider is used (for dev/E2E).
KYC_DOCUMENTS_REAL_EXTRACTION_ENABLED=false

# Admin Compute Dashboard (INFRA-012)
ADMIN_COMPUTE_DASHBOARD_ENABLED=true

# Platform Financial Dashboard (FIN-013)
PLATFORM_FINANCIAL_DASHBOARD_ENABLED=true

# Payment Provider Health (FIN-014)
PAYMENT_PROVIDER_HEALTH_ENABLED=true

# SSH Session Recording & Playback (INFRA-010)
SSH_SESSION_RECORDING_ENABLED=true
SSH_SESSION_RECORDING_DEFAULT_ENABLED=true
SSH_SESSION_RECORDING_RETENTION_DAYS=90

# Security Groups & Network Rules (INFRA-009)
SECURITY_GROUPS_ENABLED=true
SG_BLOCK_DANGEROUS_RULES=true
SG_MAX_RULES=50
SECURITY_GROUPS_PLATFORM_EGRESS_CIDRS=127.0.0.1/32,10.0.0.0/8

# Delegation API (DELEGATE-005)
DELEGATION_API_ENABLED=true
DELEGATION_API_KEYS_TABLE_NAME=delegation_api_keys
DELEGATION_API_DEFAULT_RATE_LIMIT_RPM=60
DELEGATION_API_MAX_RATE_LIMIT_RPM=300

# Per-Content Revenue Breakdown (FIN-006)
PER_CONTENT_REVENUE_ENABLED=1
PER_CONTENT_REVENUE_MAX_EXPORT_ROWS=10000
