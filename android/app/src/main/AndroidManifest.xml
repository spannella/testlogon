        <!-- AND-297: lock-screen-capable full-screen incoming-call Activity. Launched by the call
             notification's fullScreenIntent (and its accept/decline action buttons). showWhenLocked /
             turnScreenOn are also set programmatically in onCreate for API 27+. excludeFromRecents so a
             dismissed call doesn't linger in the recents list. exported=false (only the app launches it). -->
        <activity
            android:name=".feature.call.incoming.IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.TestLogon" />

        <!-- AND-132: FileProvider for handing downloaded message attachments to external viewers via
             a transient content:// read grant (no file:// leaves the app). Scoped to attachments/. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- AND-105: FCM service. exported=false so only the signed Firebase intent can reach it. -->
        <service
            android:name=".push.TlFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- AND-304: self-managed Telecom ConnectionService. exported=true + the
             BIND_TELECOM_CONNECTION_SERVICE permission so ONLY the OS Telecom subsystem can bind it. The
             OS instantiates it when TelecomCallController places/reports a self-managed call (API 26+); it
             is inert on older OS and degrades gracefully (the AND-296/297 flow is the fallback). -->
        <service
            android:name=".feature.call.telecom.TestLogonConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- AND-105/107: default channel + small icon the system uses for notification-type FCM
             messages auto-displayed while backgrounded. App-controlled data messages route through
             NotificationPresenter to the typed channels instead. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
