<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AND-107: runtime notification permission (requested at runtime on Android 13+ / API 33). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AND-297: full-screen incoming-call notification (CATEGORY_CALL qualifies on API 34+). The
         notifier still degrades to a heads-up call notification when canUseFullScreenIntent() is false. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- AND-133: microphone for voice messages (requested at runtime, API 23+).
         AND-288: also used by the host go-live broadcasting flow (RECORD_AUDIO, requested at runtime). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- AND-304: self-managed Telecom (ConnectionService). Lets the app model its 1:1 calls to the OS
         (audio focus, DND, headset/Bluetooth answer) UNDER the AND-296/297 flow. Self-managed is API 26+;
         on unsupported devices the integration no-ops and the AND-297 full-screen path remains the fallback. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- AND-288: camera for host live broadcasting (requested at runtime via activity-result). The
         go-live engine (BroadcastPublisher) is FLAGGED/stubbed until the native WebRTC SDK decision is
         made, so this permission is inert today — nothing opens the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- AND-288: optional capture-service permission declared per spec; NO real capture service is
         started while the WebRTC engine is FLAGGED. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- AND-288: hardware is optional so Play Store availability stays broad; the app degrades where
         camera/mic are absent. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

