<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY: trust system CAs + the self-signed cpp LAN cert (192.168.0.82) so the app can hit the
     C++ backend over HTTPS; cleartext still permitted for the HTTP dev backend. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/cpp_lan_cert" />
        </trust-anchors>
    </base-config>
</network-security-config>
