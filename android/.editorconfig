root = true

[*.{kt,kts}]
charset = utf-8
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
ktlint_code_style = ktlint_official
ktlint_standard_no-wildcard-imports = enabled
# Composable / Test functions are intentionally PascalCase / snake_case.
ktlint_function_naming_ignore_when_annotated_with = Composable, Test
# Multi-declaration files (e.g. DTOs, domain) need not match a single class name.
ktlint_standard_filename = disabled
