{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/messaging-compliance-query-response-v1.json",
  "title": "ComplianceArchiveQueryOutV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "items",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "https://example.local/schemas/messaging-compliance-archive-event-v1.json"
      }
    },
    "next_cursor": {
      "type": ["string", "null"]
    },
    "total_estimate": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  }
}
