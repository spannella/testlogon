{
  "title": "File Preview Reliability",
  "uid": "file-preview-reliability",
  "tags": ["filemanager", "preview", "fp-012"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Preview success rate by kind",
      "targets": [
        {
          "expr": "sum by (kind) (rate(filemgr_preview_attempts_total{outcome=\"success\"}[5m])) / clamp_min(sum by (kind) (rate(filemgr_preview_attempts_total[5m])), 1)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Preview p95 latency by kind",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(filemgr_preview_latency_seconds_bucket[5m])))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Preview fallback rate by reason",
      "targets": [
        {
          "expr": "sum by (reason) (rate(filemgr_preview_fallback_total[10m])) / clamp_min(sum(rate(filemgr_preview_attempts_total[10m])), 1)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Preview error rate",
      "targets": [
        {
          "expr": "sum(rate(filemgr_preview_attempts_total{outcome=\"error\"}[10m])) / clamp_min(sum(rate(filemgr_preview_attempts_total[10m])), 1)",
          "legendFormat": "error_rate"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Preview request volume by kind",
      "targets": [
        {
          "expr": "sum by (kind) (rate(filemgr_preview_attempts_total[15m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  }
}
